ary.\nDiscuss: 3 x 8 = 4 x 6, but 2(3 + 8) differs from 2(4 + 6).\nExit: draw another 24-square-unit rectangle.\nLook for: correct units and a counterexample with reasoning.\nKeep the conversation on the task, not learner labels.","caret":false}},{"command":"type.char","params":{"attrs":{"fontFamily":"Tahoma","fontStyle":"Regular","size":12,"leading":{"kind":"points","value":20}}}},{"command":"type.para","params":{"attrs":{"direction":"leftToRight","align":"left","hyphenate":false}}},{"command":"line.create","params":{"spread":0,"a":[54,142],"b":[540,142]}},{"command":"object.stroke","params":{"ids":["$33.id"],"swatch":"[Black]","weight":0.7,"cap":"round","join":"round"}},{"command":"line.create","params":{"spread":0,"a":[54,741],"b":[540,741]}},{"command":"object.stroke","params":{"ids":["$35.id"],"swatch":"[Black]","weight":0.7,"cap":"round","join":"round"}},{"command":"frame.create","params":{"spread":0,"rect":[54,751,540,785],"content":"text","text":"Original sample | Standards unverified | Teacher review required","caret":false}},{"command":"type.char","params":{"attrs":{"fontFamily":"Tahoma","fontStyle":"Regular","size":11,"leading":{"kind":"points","value":19}}}},{"command":"type.para","params":{"attrs":{"direction":"leftToRight","align":"left","hyphenate":false}}}]